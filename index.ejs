<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Weather Dashboard</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap');

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* ============================================================
         BACKGROUND SYSTEM
         Two layers stacked on top of each other.
         When weather changes, we fade bg-a out/in so it feels smooth.
         ============================================================ */
    #bg-a,
    #bg-b {
      position: fixed;
      inset: 0;
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
      z-index: -2;
      pointer-events: none;
      transition: opacity 1s ease-in-out;
    }

    #bg-b {
      opacity: 0;
    }

    /* hidden by default — used for crossfade */

    /* Dark gradient overlay so UI text stays readable */
    #bg-overlay {
      position: fixed;
      inset: 0;
      background: linear-gradient(to bottom,
          rgba(0, 0, 0, 0.45) 0%,
          rgba(0, 0, 0, 0.25) 40%,
          rgba(0, 0, 0, 0.55) 100%);
      z-index: -1;
      pointer-events: none;
      transition: background 1s ease;
    }

    /* Everything else sits above the background */
    body {
      font-family: 'Inter', Arial, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: white;
      padding: 1.5rem 1rem;
      position: relative;
      z-index: 2;
    }

    /* Weather condition label (top-left badge, like the reference) */
    .condition-badge {
      position: fixed;
      top: 1.5rem;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.25);
      padding: 0.35rem 1rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      z-index: 10;
      transition: opacity 0.4s;
    }

    /* Search bar */
    .search-form {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      width: 100%;
      max-width: 440px;
    }

    .search-wrapper {
      position: relative;
      flex: 1;
      display: flex;
    }

    .search-wrapper input {
      width: 100%;
      padding: 0.85rem 1.1rem;
      border-radius: 14px;
      border: 1.5px solid rgba(255, 255, 255, 0.25);
      background: rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(12px);
      color: white;
      font-size: 1rem;
      font-family: inherit;
      outline: none;
      transition: border 0.2s, background 0.2s;
    }

    .search-wrapper input::placeholder {
      color: rgba(255, 255, 255, 0.55);
    }

    .search-wrapper input:focus {
      border-color: rgba(255, 255, 255, 0.6);
      background: rgba(255, 255, 255, 0.18);
    }

    .suggestions {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin-top: 0.5rem;
      background: rgba(30, 40, 50, 0.9);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 14px;
      overflow: hidden;
      z-index: 100;
      display: none;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    .suggestion-item {
      padding: 0.85rem 1rem;
      cursor: pointer;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      transition: background 0.2s;
      text-align: left;
    }

    .suggestion-item:last-child {
      border-bottom: none;
    }

    .suggestion-item:hover {
      background: rgba(255, 255, 255, 0.15);
    }

    .suggestion-main {
      font-weight: 600;
      font-size: 0.95rem;
    }

    .suggestion-sub {
      font-size: 0.75rem;
      opacity: 0.65;
      margin-top: 0.15rem;
    }

    .search-form button {
      padding: 0.85rem 1.3rem;
      border-radius: 14px;
      border: none;
      background: rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(12px);
      color: white;
      font-size: 1rem;
      font-family: inherit;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      min-width: 100px;
      border: 1.5px solid rgba(255, 255, 255, 0.3);
    }

    .search-form button:hover {
      background: rgba(255, 255, 255, 0.3);
      transform: scale(1.03);
    }

    .search-form button.loading {
      background: rgba(255, 255, 255, 0.1);
      cursor: not-allowed;
      transform: none;
    }

    /* Status bar */
    .status-msg {
      max-width: 440px;
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 12px;
      margin-bottom: 1rem;
      font-size: 0.95rem;
      font-weight: 600;
      display: none;
      text-align: center;
      backdrop-filter: blur(8px);
    }

    .status-msg.error {
      background: rgba(220, 50, 50, 0.3);
      border: 1px solid rgba(255, 100, 100, 0.5);
      display: block;
    }

    .status-msg.success {
      background: rgba(0, 200, 100, 0.2);
      border: 1px solid rgba(0, 200, 100, 0.4);
      display: block;
    }

    /* Main weather card — glassmorphism */
    .card {
      background: rgba(0, 0, 0, 0.25);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 2rem 2.5rem;
      border-radius: 28px;
      text-align: center;
      box-shadow: 0 12px 50px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.12);
      width: 100%;
      max-width: 440px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      transition: opacity 0.3s ease;
    }

    .card.fading {
      opacity: 0.4;
    }

    .city-name {
      font-size: 1rem;
      font-weight: 600;
      opacity: 0.8;
      margin-bottom: 0.25rem;
      letter-spacing: 0.04em;
    }

    .temp {
      font-size: 5.5rem;
      font-weight: 800;
      line-height: 1;
      margin: 0.4rem 0;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .desc {
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
      opacity: 0.95;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    }

    .details {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0.7rem;
      margin-bottom: 1.25rem;
    }

    .detail {
      background: rgba(255, 255, 255, 0.1);
      padding: 0.75rem 0.5rem;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(8px);
    }

    .label {
      font-size: 0.68rem;
      opacity: 0.6;
      margin-bottom: 0.25rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }

    .value {
      font-size: 1.25rem;
      font-weight: 700;
    }

    .time {
      opacity: 0.4;
      font-size: 0.78rem;
      margin-top: 0.25rem;
    }

    /* 5-day forecast strip */
    .forecast-strip {
      display: flex;
      gap: 0.6rem;
      margin-top: 1rem;
      width: 100%;
      max-width: 440px;
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }

    .forecast-strip::-webkit-scrollbar {
      height: 4px;
    }

    .forecast-strip::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.25);
      border-radius: 10px;
    }

    .forecast-day {
      flex: 1;
      min-width: 72px;
      background: rgba(0, 0, 0, 0.25);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 18px;
      padding: 0.85rem 0.5rem;
      text-align: center;
      animation: fadeUp 0.5s ease both;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .forecast-day:nth-child(1) {
      animation-delay: 0.00s;
    }

    .forecast-day:nth-child(2) {
      animation-delay: 0.06s;
    }

    .forecast-day:nth-child(3) {
      animation-delay: 0.12s;
    }

    .forecast-day:nth-child(4) {
      animation-delay: 0.18s;
    }

    .forecast-day:nth-child(5) {
      animation-delay: 0.24s;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .forecast-day.today {
      background: rgba(255, 255, 255, 0.18);
      border-color: rgba(255, 255, 255, 0.35);
    }

    .forecast-day .f-day {
      font-size: 0.68rem;
      opacity: 0.6;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      margin-bottom: 0.4rem;
    }

    .forecast-day .f-icon {
      font-size: 1.7rem;
      margin-bottom: 0.3rem;
    }

    .forecast-day .f-max {
      font-size: 1rem;
      font-weight: 700;
    }

    .forecast-day .f-min {
      font-size: 0.8rem;
      opacity: 0.5;
      margin-top: 0.1rem;
    }

    .forecast-day .f-rain {
      font-size: 0.68rem;
      opacity: 0.6;
      margin-top: 0.35rem;
    }

    @media (max-width: 500px) {
      .temp {
        font-size: 4rem;
      }

      .details {
        grid-template-columns: 1fr 1fr;
      }

      .card {
        padding: 1.5rem 1.25rem;
      }
    }
  </style>
</head>

<body>

  <!-- Background image layers (z-index: -2) -->
  <div id="bg-a" style="background-image: url('/images/<%= hourToImage(localHour) %>')"></div>
  <div id="bg-b"></div>
  <div id="bg-overlay"></div>

  <!-- Floating weather badge at very top -->
  <div class="condition-badge" id="condition-badge">
    <%= desc %>
  </div>

  <!-- Search form -->
  <form class="search-form" id="search-form">
    <div class="search-wrapper">
      <input type="text" name="city" id="city-input" placeholder="Search any city..." value="<%= city %>"
        autocomplete="off" />
      <div class="suggestions" id="suggestions-box"></div>
    </div>
    <button type="submit" id="search-btn">🔍 Search</button>
  </form>

  <div class="status-msg" id="status-msg"></div>

  <!-- Main weather card -->
  <div class="card" id="weather-card">
    <div class="city-name" id="city-name">📍 <%= city %></div>
    <div id="live-clock" style="
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      opacity: 0.9;
      margin: 0.2rem 0 0.1rem;
      text-shadow: 0 2px 10px rgba(0,0,0,0.3);
    ">--:-- --</div>
    <div id="live-date" style="
      font-size: 0.78rem;
      opacity: 0.55;
      margin-bottom: 0.6rem;
      letter-spacing: 0.04em;
    "></div>
    <div class="temp" id="temp"><%= temp %>°C</div>
    <div class="desc" id="desc"><%= desc %></div>
    <div class="details">
      <div class="detail">
        <div class="label">Feels Like</div>
        <div class="value" id="feels"><%= feels %>°C</div>
      </div>
      <div class="detail">
        <div class="label">Wind</div>
        <div class="value" id="wind"><%= wind %> km/h</div>
      </div>
      <div class="detail">
        <div class="label">Rain Chance</div>
        <div class="value" id="precip"><%= precip %>%</div>
      </div>
    </div>
    <div class="time" id="time">🕐 Updated: <%= time %></div>
  </div>

  <!-- 5-day forecast strip -->
  <div class="forecast-strip" id="forecast-strip">
    <% forecast.forEach(function(day, i) { %>
      <div class="forecast-day <%= i === 0 ? 'today' : '' %>">
        <div class="f-day">
          <%= day.dayName %>
        </div>
        <div class="f-icon">
          <%= day.icon %>
        </div>
        <div class="f-max">
          <%= day.maxTemp %>°
        </div>
        <div class="f-min">
          <%= day.minTemp %>°
        </div>
        <div class="f-rain">💧 <%= day.precip %>%</div>
      </div>
      <% }) %>
  </div>

  <!--
      EJS helper — called above for the initial page render.
      Maps local hour to an image filename. Defined as a helper
      function available in the EJS template context.
    -->
  <% function hourToImage(hour) { if (hour>= 5 && hour < 10) return 'morning.png' ; if (hour>= 10 && hour < 16)
        return 'afternoon.png' ; if (hour>= 16 && hour < 19) return 'evening.png' ; return 'night.png' ; } %>

          <script>
            /* ============================================================
               BACKGROUND CROSSFADE ENGINE
               ============================================================
               We have two <div> layers: bg-a and bg-b (both position:fixed).
               Only one is visible at a time (opacity 1 vs 0).
               
               To switch background:
                 1. Load new image into the INVISIBLE layer
                 2. Fade invisible → visible (opacity 0→1)
                 3. Fade old visible → invisible (opacity 1→0)
                 4. Swap our mental track of "which is active"
               
               This gives a buttery smooth crossfade with no white flash.
               ============================================================ */
            const bgA = document.getElementById('bg-a');
            const bgB = document.getElementById('bg-b');
            let activeLayer = 'a';   // track which layer is currently showing

            // JS version of the server-side hourToImage() above
            function hourToImage(hour) {
              if (hour >= 5 && hour < 10) return 'morning.png';
              if (hour >= 10 && hour < 16) return 'afternoon.png';
              if (hour >= 16 && hour < 19) return 'evening.png';
              return 'night.png';
            }

            // Overlay tints that complement each time of day
            const overlayTints = {
              'morning.png': 'linear-gradient(to bottom, rgba(200,100,50,0.15) 0%, rgba(50,80,120,0.2) 50%, rgba(0,0,0,0.5) 100%)',
              'afternoon.png': 'linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(10,50,100,0.15) 50%, rgba(0,0,0,0.45) 100%)',
              'evening.png': 'linear-gradient(to bottom, rgba(40,10,30,0.3) 0%, rgba(20,10,40,0.25) 50%, rgba(0,0,0,0.55) 100%)',
              'night.png': 'linear-gradient(to bottom, rgba(0,0,20,0.4) 0%, rgba(10,10,30,0.3) 50%, rgba(0,0,0,0.65) 100%)',
            };

            function switchBackground(newImageFile) {
              const overlay = document.getElementById('bg-overlay');
              const newUrl = `/images/${newImageFile}`;

              if (activeLayer === 'a') {
                // Load new image into bg-b, then crossfade
                bgB.style.backgroundImage = `url('${newUrl}')`;
                bgB.style.opacity = '1';
                bgA.style.opacity = '0';
                activeLayer = 'b';
              } else {
                // Load new image into bg-a, then crossfade
                bgA.style.backgroundImage = `url('${newUrl}')`;
                bgA.style.opacity = '1';
                bgB.style.opacity = '0';
                activeLayer = 'a';
              }

              // Update overlay tint to match the new weather mood
              if (overlayTints[newImageFile]) {
                overlay.style.background = overlayTints[newImageFile];
              }
            }

            /* ============================================================
               DOM UPDATE FUNCTIONS
               ============================================================ */
            const form = document.getElementById('search-form');
            const input = document.getElementById('city-input');
            const btn = document.getElementById('search-btn');
            const card = document.getElementById('weather-card');
            const statusMsg = document.getElementById('status-msg');
            const forecastEl = document.getElementById('forecast-strip');
            const badge = document.getElementById('condition-badge');

            function showStatus(msg, type) {
              statusMsg.textContent = msg;
              statusMsg.className = `status-msg ${type}`;
            }
            function clearStatus() {
              statusMsg.className = 'status-msg';
              statusMsg.textContent = '';
            }

            let currentCityTimezone = "<%= typeof timezone !== 'undefined' ? timezone : 'UTC' %>";

            // Live ticking clock — updates every second
            function tickClock() {
              if (!currentCityTimezone) return;
              try {
                const now = new Date();
                const clockEl = document.getElementById('live-clock');
                const dateEl  = document.getElementById('live-date');
                if (clockEl) {
                  clockEl.textContent = now.toLocaleTimeString('en-US', {
                    timeZone: currentCityTimezone,
                    hour: 'numeric', minute: '2-digit', second: '2-digit', hour12: true
                  });
                }
                if (dateEl) {
                  dateEl.textContent = now.toLocaleDateString('en-US', {
                    timeZone: currentCityTimezone,
                    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                  });
                }
              } catch(e) {}
            }
            tickClock();
            setInterval(tickClock, 1000);

            function updateCard(data) {
              if (data.timezone) {
                currentCityTimezone = data.timezone;
                tickClock(); // immediately refresh clock for new city
              }
              document.getElementById('city-name').textContent = '📍 ' + data.city;
              document.getElementById('temp').textContent = data.temp + '°C';
              document.getElementById('desc').textContent = data.desc;
              document.getElementById('feels').textContent = data.feels + '°C';
              document.getElementById('wind').textContent = data.wind + ' km/h';
              document.getElementById('precip').textContent = data.precip + '%';
              document.getElementById('time').textContent = '🕐 Updated: ' + data.time;
              badge.textContent = data.desc;
              document.title = data.city + ' Weather';
              const imgFile = hourToImage(data.localHour);
              switchBackground(imgFile);
            }

            function updateForecast(forecastArr) {
              const html = forecastArr.map((day, i) => `
          <div class="forecast-day ${i === 0 ? 'today' : ''}">
            <div class="f-day">${day.dayName}</div>
            <div class="f-icon">${day.icon}</div>
            <div class="f-max">${day.maxTemp}°</div>
            <div class="f-min">${day.minTemp}°</div>
            <div class="f-rain">💧 ${day.precip}%</div>
          </div>
        `).join('');
              forecastEl.innerHTML = html;
            }

            /* ============================================================
               SEARCH — AJAX with fetch()
               ============================================================ */
            form.addEventListener('submit', async function (event) {
              event.preventDefault();
              const city = input.value.trim();
              if (!city) return;

              btn.textContent = '⏳ ...';
              btn.classList.add('loading');
              btn.disabled = true;
              card.classList.add('fading');
              clearStatus();

              try {
                const response = await fetch(`/api/weather?city=${encodeURIComponent(city)}`);
                const result = await response.json();

                if (result.success) {
                  updateCard(result.data);
                  updateForecast(result.data.forecast);
                  clearStatus();
                } else {
                  showStatus('❌ ' + result.error, 'error');
                }
              } catch (err) {
                showStatus('🚫 Network error — is the server running?', 'error');
              }

              btn.textContent = '🔍 Search';
              btn.classList.remove('loading');
              btn.disabled = false;
              card.classList.remove('fading');
            });

            /* ============================================================
               AUTOCOMPLETE SUGGESTIONS
               ============================================================ */
            const suggestionsBox = document.getElementById('suggestions-box');
            let debounceTimeout;

            input.addEventListener('input', (e) => {
              const query = e.target.value.trim();
              clearTimeout(debounceTimeout);

              if (query.length < 2) {
                suggestionsBox.style.display = 'none';
                return;
              }

              debounceTimeout = setTimeout(async () => {
                try {
                  const res = await fetch(`/api/suggest?q=${encodeURIComponent(query)}`);
                  const data = await res.json();

                  if (data.success && data.results.length > 0) {
                    suggestionsBox.innerHTML = '';
                    data.results.forEach(item => {
                      const div = document.createElement('div');
                      div.className = 'suggestion-item';
                      const locDetails = [item.admin1, item.country].filter(Boolean).join(', ');
                      div.innerHTML = `
                   <div class="suggestion-main">${item.name}</div>
                   <div class="suggestion-sub">${locDetails}</div>
                 `;
                      div.addEventListener('click', () => {
                        input.value = `${item.name}${locDetails ? ', ' + item.country : ''}`;
                        suggestionsBox.style.display = 'none';
                        form.dispatchEvent(new Event('submit')); // Auto submit
                      });
                      suggestionsBox.appendChild(div);
                    });
                    suggestionsBox.style.display = 'block';
                  } else {
                    suggestionsBox.style.display = 'none';
                  }
                } catch (err) {
                  console.error('Suggestion fetch failed');
                }
              }, 300); // 300ms debounce
            });

            // Hide suggestions when clicking outside
            document.addEventListener('click', (e) => {
              if (!e.target.closest('.search-wrapper')) {
                suggestionsBox.style.display = 'none';
              }
            });

            // Auto-refresh every 10 minutes
            setInterval(async () => {
              const city = document.getElementById('city-name').textContent.replace('📍 ', '');
              try {
                const res = await fetch(`/api/weather?city=${encodeURIComponent(city)}`);
                const result = await res.json();
                if (result.success) {
                  updateCard(result.data);
                  updateForecast(result.data.forecast);
                }
              } catch (e) { console.warn('Auto-refresh failed:', e); }
            }, 600000);

            // Ticking Live Clock for Local Time
            setInterval(() => {
              if (!currentCityTimezone || currentCityTimezone === 'UTC') return;
              try {
                const now = new Date();
                const timeString = now.toLocaleTimeString('en-US', {
                  timeZone: currentCityTimezone,
                  hour: 'numeric',
                  minute: '2-digit',
                  second: '2-digit',
                  hour12: true
                });
                const timeEl = document.getElementById('local-time');
                if (timeEl) timeEl.textContent = timeString;
              } catch(e) {}
            }, 1000);
          </script>
</body>
</html>